{
  "compilerOptions": {
    /* Runtime target */
    "target": "ES2020",
    "module": "commonjs",

    /* Project structure */
    "rootDir": "./src",
    "outDir": "./dist",

    /* Interop */
    "esModuleInterop": true,
    "resolveJsonModule": true,

    /* Type safety */
    "strict": true,
    "forceConsistentCasingInFileNames": true,

    /* Node environment */
    "types": ["node"],

    /* Performance */
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}