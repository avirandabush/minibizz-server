// For each change, run: npx prisma db push
// For dev and prod DB.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id   String @id
  name String

  contact     String @db.LongText
  business    String @db.LongText
  preferences String @db.LongText

  plan   String
  status String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime

  customers  Customer[]
  payments   Payment[]
  treatments Treatment[]
}

model Customer {
  id     String @id @default(uuid())
  userId String

  personal String @db.LongText
  contact  String @db.LongText
  stats    String @db.LongText

  leadSource String
  isActive   Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  payments Payment[]

  @@index([userId])
}

model Treatment {
  id     String @id @default(uuid())
  userId String

  name        String
  description String

  isFavorite Boolean @default(false)
  isActive   Boolean @default(true)

  specs String @db.LongText
  color String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Payment {
  id         String @id @default(uuid())
  userId     String
  customerId String

  items   String @db.LongText
  summary String @db.LongText

  method String
  status String
  date   DateTime

  referenceNumber String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([userId])
  @@index([customerId])
}
